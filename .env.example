# Optional LLM Providers (leave blank to run in zero-cost Deterministic + RAG mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional External CRM Webhook URL (simulated locally in SQLite if empty)
CRM_WEBHOOK_URL=

# Server Settings
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=./sales_agent.db
PII_REDACTION_ENABLED=true
